# Local development ports.
# 5001/5174 rather than the usual 5000/5173 because those are commonly taken
# by other projects on the same machine, and a silent clash is confusing:
# whichever service wins the port is the only one that appears to work.
# The frontend dev server pins 5174 via strictPort, and VITE_API_URL must
# match this PORT, or the browser gets a CORS error on every request.
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/essa_school
MONGODB_USERNAME=
MONGODB_PASSWORD=

JWT_SECRET=replace_with_a_long_random_string

# Origin allowed by CORS. Must match the URL you actually open the frontend on.
FRONTEND_URL=http://localhost:5174

# Outbound email (Gmail app password or SMTP provider)
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=
ADMIN_PASSWORD=replace_with_a_strong_password

# Optional third-party gateways
URUBUTO_API_KEY=
URUBUTO_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
